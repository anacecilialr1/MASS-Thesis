@ARTICLE{Souffrin1988BLR,
 ISSN = {00046280, 15383873},
 URL = {http://www.jstor.org/stable/40679324},
 abstract = {Broad emission lines which are the most characteristic features of Active Galactic Nuclei and quasars can be separated into two distinct systems: the "high-ionization lines" (HIL) and "low-ionization lines" (HIL). HILs are emitted by low-pressure optically-thin "clouds" illuminated by a rather soft continuum radiation; LILs are produced by a high-pressure optically-thick medium, illuminated mainly by hard X-rays, possibly the outer region of an accretion disk. This recent version of the photoionization model of the broad-line region is still unable to provide a consistent explanation of the unusual intensities of the iron Fe ii lines in strong optical Fe ii emitters.},
